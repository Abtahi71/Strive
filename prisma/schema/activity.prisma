model Activity {
  id            String                  @id @default(uuid())
  name          String
  description   String
  imageUrl      String
  memberCount   Int                     @default(0)
  taskCount     Int                     @default(0)
  creatorId     String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  visibility    Visibility
  creator       User                    @relation("ActivityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  dailyProgress ActivityDailyProgress[]
  invitations   ActivityInvitation[]
  members       ActivityMember[]
  task          ActivityTask[]
  group         ConversationGroup?

  @@index([visibility])
  @@index([creatorId])
}

model ActivityMember {
  id             String       @id @default(uuid())
  userId         String
  activityId     String
  role           ActivityRole
  joinedAt       DateTime
  leftAt         DateTime?
  isActive       Boolean      @default(true)
  currentStreak  Int          @default(0)
  longestStreak  Int          @default(0)
  completionRate Float        @default(0)
  activity       Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

model ActivityInvitation {
  id         String    @id @default(uuid())
  activityId String
  senderId   String
  receiverId String
  expiresAt  DateTime?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  activity   Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  receiver   User      @relation("InvitationReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User      @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId, activityId, senderId])
}

model Quiz {
  id       String   @id @default(uuid())
  question String
  answer   String?
  options  String[]
}

model ActivityTask {
  id           String            @id @default(uuid())
  activityId   String
  unit         String
  targetValue  Float
  scheduleType ScheduleType      @default(DAILY)
  name         String
  description  String
  imageUrl     String?
  creatorId    String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  taskType     TaskType          @default(VALUE)
  activity     Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  creator      User              @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  acheivements TaskAchievement[]
  progress     TaskProgress[]
  schedules    TaskSchedule[]

  @@index([activityId])
  @@index([creatorId])
}

model TaskSchedule {
  id     String       @id @default(uuid())
  taskId String
  day    DayOfWeek
  task   ActivityTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, day])
}

model TaskProgress {
  id             String              @id @default(uuid())
  activityId     String
  taskId         String
  userId         String
  date           DateTime
  completedValue Decimal             @db.Decimal(10, 2)
  targetSnapshot Decimal             @db.Decimal(10, 2)
  isCompleted    Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  currentStreak  Int                 @default(0)
  longestStreak  Int                 @default(0)
  task           ActivityTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries        TaskProgressEntry[]

  @@unique([taskId, userId, date])
  @@index([taskId])
  @@index([userId])
}

model TaskProgressEntry {
  id         String       @id @default(uuid())
  progressId String
  value      Decimal      @db.Decimal(10, 2)
  note       String?
  createdAt  DateTime     @default(now())
  progress   TaskProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@index([progressId])
}

model ActivityDailyProgress {
  id                   String   @id @default(uuid())
  activityId           String
  userId               String
  date                 DateTime
  completedTasks       Int
  totalTasks           Int
  completionPercentage Decimal  @db.Decimal(5, 2)
  completed            Boolean
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  task                 Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId, date])
  @@index([activityId])
  @@index([userId])
}

enum TaskType {
  VALUE
  CHECKLIST
  DOWN
  QUIZ
}
