model TaskAchievement {
  id          String                @id @default(uuid())
  taskId      String
  title       String
  description String
  iconUrl     String?
  totalValue  Int
  unit        String?
  createdAt   DateTime              @default(now())
  iconType    IconType?             @default(DEFAULT)
  iconValue   String?
  task        ActivityTask          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  users       UserTaskAchievement[]
}

model UserTaskAchievement {
  id              String          @id @default(uuid())
  userId          String
  achievementId   String
  isEarned        Boolean
  completedValue  Int             @default(0)
  completedStreak Int             @default(0)
  achievement     TaskAchievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

enum IconType {
  DEFAULT
  ICON
  PREBUILT
  CUSTOM
  EMOJI
}
