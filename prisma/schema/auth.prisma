model User {
  id                    String                  @id @default(uuid())
  name                  String?
  username              String?                  @unique
  email                 String?                  @unique
  password              String?
  avatar                String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  globalRole            GlobalRole              @default(USER)
  isActive              Boolean                 @default(true)
  googleId              String? @unique

  createdActivities     Activity[]              @relation("ActivityCreator")
  ActivityDailyProgress ActivityDailyProgress[]
  receivedInvitations   ActivityInvitation[]    @relation("InvitationReceiver")
  sentInvitations       ActivityInvitation[]    @relation("InvitationSender")
  activity              ActivityMember[]
  createdTasks          ActivityTask[]          @relation("TaskCreator")
  receivedRequests      Friendship[]            @relation("FriendReceiver")
  sentRequests          Friendship[]            @relation("FriendRequester")
  messages              Message[]
  notification          Notification[]
  passwordResets        PasswordReset[]
  sessions              Session[]
  progress              TaskProgress[]
  profile               UserProfile?
  achievements          UserTaskAchievement[]
  chats                 ChatConversation[]
  websiteUsage          WebsiteUsage[]
  googleLoginCodes      GoogleLoginCode[]

  @@index([email])
  @@index([username])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  deviceName       String?
  ipAdress         String?
  userAgent        String?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  websiteUsage     WebsiteUsage[]

  @@index([userId])
}

model UserProfile {
  id        String    @id @default(uuid())
  userId    String    @unique
  firstName String?
  lastName  String?
  bio       String?
  avatarUrl String?
  birthDate DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  status      FriendshipStatus
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  receiver    User             @relation("FriendReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  requester   User             @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}


model GoogleLoginCode {
  id        String   @id @default(cuid())
  codeHash  String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
